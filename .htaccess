RewriteEngine On

RewriteRule ^index\.html$ https://vasquezandservices.com/ [R=301,L]
RewriteRule ^menu\.html$ https://vasquezandservices.com/services.html [R=301,L]
RewriteRule ^blog\.html$ https://vasquezandservices.com/promotions.html [R=301,L]
RewriteRule ^blog-detail\.html$ https://vasquezandservices.com/promotions.html [R=301,L]
RewriteRule ^quote\.html$ https://vasquezandservices.com/contact.html [R=301,L]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^vasquezandservices\.com$ [NC]
RewriteRule ^ https://vasquezandservices.com%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:avif|webp|jpe?g|png|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
